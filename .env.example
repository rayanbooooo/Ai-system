# Copy this file to .env and fill in your own values. Never commit .env.

# --- Tradovate API (see docs/TRADOVATE_SETUP.md) ---
TRADOVATE_ENV=demo                 # demo | live -- confirm which one your Apex account routes through
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=ai-system
TRADOVATE_APP_VERSION=1.0

# --- Telegram (see docs/TELEGRAM_SETUP.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Vault ---
VAULT_PATH=./vault
